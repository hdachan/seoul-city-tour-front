  "html": "<div class=\\"modal\\" style=\\"width: 480px; border-radius: 14px; max-height: 90vh;\\"><div class=\\"modal-header\\"><h3 class=\\"modal-title\\" style=\\"margin: 0px;\\">운행일지 추가</h3><button class=\\"modal-close\\">✕</button></div><form class=\\"modal-form\\"><div class=\\"field\\"><label>날짜 *</label><input required=\\"\\" type=\\"date\\" value=\\"2026-10-22\\"></div><div style=\\"background: rgb(254, 243, 199); border-radius: 8px; padding: 12px; border: 1px solid #fde68a;\\"><p style=\\"font-size: 12px; font-weight: 600; color: rgb(146, 64, 14); margin-bottom: 10px;\\">⛽ 주유 정보</p><div style=\\"display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;\\"><div class=\\"field\\"><label>주유량 *</label><div style=\\"position: relative;\\"><input step=\\"0.01\\" placeholder=\\"48.13\\" style=\\"width: 100%; padding-right: 24px;\\" required=\\"\\" type=\\"number\\" value=\\"10\\"><span style=\\"position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-size: 11px; color: rgb(136, 136, 136); font-weight: 600; pointer-events: none;\\">L</span></div></div><div class=\\"field\\"><label>주유금액 *</label><div style=\\"position: relative;\\"><input placeholder=\\"52000\\" style=\\"width: 100%; padding-right: 24px;\\" required=\\"\\" type=\\"number\\" value=\\"11\\"><span style=\\"position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-size: 11px; color: rgb(136, 136, 136); font-weight: 600; pointer-events: none;\\">원</span></div></div><div class=\\"field\\"><label>단가 *</label><div style=\\"position: relative;\\"><input placeholder=\\"1615\\" style=\\"width: 100%; padding-right: 24px;\\" required=\\"\\" type=\\"number\\" value=\\"12\\"><span style=\\"position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-size: 11px; color: rgb(136, 136, 136); font-weight: 600; pointer-events: none;\\">원</span></div></div></div></div><div class=\\"field\\"><label>구분 *</label><div style=\\"display: flex; gap: 6px;\\"><button type=\\"button\\" style=\\"flex: 1; padding: 9px; border-radius: 8px; font-size: 13px; cursor: pointer; font-weight: 400; color: rgb(136, 136, 136); border: 1.5px solid #e0e0e0; background: rgb(255, 255, 255);\\">💼 업무</button><button type=\\"button\\" style=\\"flex: 1; padding: 9px; border-radius: 8px; font-size: 13px; cursor: pointer; font-weight: 700; color: rgb(146, 64, 14); border: 1.5px solid #92400e; background: rgb(254, 243, 199);\\">⛽ 주유</button><button type=\\"button\\" style=\\"flex: 1; padding: 9px; border: 1.5px solid #e0e0e0; border-radius: 8px; font-size: 13px; cursor: pointer; font-weight: 400; background: rgb(255, 255, 255); color: rgb(136, 136, 136);\\">⛽ 개인주유</button><button type=\\"button\\" style=\\"flex: 1; padding: 9px; border: 1.5px solid #e0e0e0; border-radius: 8px; font-size: 13px; cursor: pointer; font-weight: 400; background: rgb(255, 255, 255); color: rgb(136, 136, 136);\\">🚗 개인사용</button></div></div><div class=\\"modal-btns\\"><button type=\\"button\\" class=\\"btn-outline\\">취소</button><button type=\\"submit\\" class=\\"btn-primary\\">추가</button></div></form></div>",
  "values": Array [
    "input[date]  = 2026-10-22",
    "input[number] 48.13 = 10",
    "input[number] 52000 = 11",
    "input[number] 1615 = 12",
  ],
}
`;

