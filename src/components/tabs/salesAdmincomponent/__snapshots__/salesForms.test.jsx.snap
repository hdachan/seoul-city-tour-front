  "html": "<div class=\\"modal\\" style=\\"width: 480px; border-radius: 14px; max-height: 90vh;\\"><div class=\\"modal-header\\"><h3 class=\\"modal-title\\" style=\\"margin: 0px;\\">운행일지 수정</h3><button class=\\"modal-close\\">✕</button></div><form class=\\"modal-form\\"><div class=\\"field\\"><label>날짜 *</label><input min=\\"2026-10-19\\" max=\\"2026-10-25\\" required=\\"\\" type=\\"date\\" value=\\"2026-10-22\\"></div><div style=\\"display: flex; gap: 10px;\\"><div class=\\"field\\" style=\\"flex: 1; min-width: 0;\\"><label style=\\"font-size: 13px; font-weight: 700; color: rgb(21, 87, 176);\\">🚗 출발 시간</label><input style=\\"font-size: 16px; padding: 12px; letter-spacing: 1px; width: 100%; box-sizing: border-box;\\" type=\\"time\\" value=\\"08:00\\"></div><div class=\\"field\\" style=\\"flex: 1; min-width: 0;\\"><label style=\\"font-size: 13px; font-weight: 700; color: rgb(21, 87, 176);\\">🕐 도착 시간 *</label><input required=\\"\\" style=\\"font-size: 16px; padding: 12px; letter-spacing: 1px; width: 100%; box-sizing: border-box;\\" type=\\"time\\" value=\\"09:00\\"></div></div><div class=\\"field\\" style=\\"position: relative;\\"><label>도착지 *</label><input placeholder=\\"경복궁\\" autocomplete=\\"off\\" required=\\"\\" type=\\"text\\" value=\\"명동\\"></div><div class=\\"field\\"><label>미터기 (km) * <span style=\\"font-size: 11px; color: rgb(21, 87, 176); font-weight: 400;\\">현재 기준: 900km 이상</span></label><div style=\\"position: relative;\\"><input placeholder=\\"오늘 계량기\\" style=\\"width: 100%; padding-right: 40px;\\" required=\\"\\" type=\\"number\\" value=\\"1000\\"><span style=\\"position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-size: 13px; color: rgb(136, 136, 136); font-weight: 600; pointer-events: none;\\">km</span></div><p style=\\"font-size: 12px; color: rgb(21, 87, 176); margin-top: 4px; font-weight: 600;\\">운행거리: 0km</p></div><div class=\\"field\\"><label style=\\"display: flex; justify-content: space-between; align-items: center;\\"><span>비고</span><button type=\\"button\\" style=\\"font-size: 11px; color: rgb(21, 87, 176); background: none; border: 1px solid #1557b0; border-radius: 6px; padding: 2px 8px; cursor: pointer;\\">＋ 추가</button></label><div style=\\"display: flex; gap: 6px; margin-bottom: 6px; align-items: center;\\"><input style=\\"width: 130px; flex-shrink: 0;\\" type=\\"time\\" value=\\"08:30\\"><input placeholder=\\"비고 1\\" style=\\"flex: 1;\\" type=\\"text\\" value=\\"고객방문\\"></div></div><div class=\\"field\\"><label>구분 *</label><div style=\\"display: flex; gap: 6px;\\"><button type=\\"button\\" style=\\"flex: 1; padding: 10px; border: 1.5px solid #1557b0; border-radius: 8px; font-size: 13px; cursor: pointer; font-weight: 700; background: rgb(232, 240, 254); color: rgb(21, 87, 176);\\">💼 업무</button><button type=\\"button\\" style=\\"flex: 1; padding: 10px; border: 1.5px solid #e0e0e0; border-radius: 8px; font-size: 13px; cursor: pointer; font-weight: 400; background: rgb(255, 255, 255); color: rgb(136, 136, 136);\\">⛽ 주유</button><button type=\\"button\\" style=\\"flex: 1; padding: 10px; border: 1.5px solid #e0e0e0; border-radius: 8px; font-size: 13px; cursor: pointer; font-weight: 400; background: rgb(255, 255, 255); color: rgb(136, 136, 136);\\">⛽ 개인주유</button><button type=\\"button\\" style=\\"flex: 1; padding: 10px; border: 1.5px solid #e0e0e0; border-radius: 8px; font-size: 13px; cursor: pointer; font-weight: 400; background: rgb(255, 255, 255); color: rgb(136, 136, 136);\\">🚗 개인사용</button></div></div><div class=\\"modal-btns\\"><button type=\\"button\\" class=\\"btn-outline\\">취소</button><button type=\\"submit\\" class=\\"btn-primary\\">수정</button></div></form></div>",
  "values": Array [
    "input[date]  = 2026-10-22",
    "input[time]  = 08:00",
    "input[time]  = 09:00",
    "input[text] 경복궁 = 명동",
    "input[number] 오늘 계량기 = 1000",
    "input[time]  = 08:30",
    "input[text] 비고 1 = 고객방문",
  ],
}
`;

